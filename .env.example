# Copy to .env. No secrets are hardcoded; the first admin is created via POST /api/v1/setup.
DATABASE_URL=sqlite:///./cybershield.db
# PostgreSQL (docker): postgresql+psycopg://cybershield:CHANGE_ME@db:5432/cybershield
SESSION_HOURS=8
IDLE_MINUTES=15
LOCK_MINUTES=15
MAX_FAILED_LOGINS=5
RATE_LIMIT_PER_MIN=20
# Module 4: notifications (leave SMTP_HOST empty to disable email; use a secret store for SMTP_PASSWORD)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=cybershield@example.org
WEBHOOK_URL=
ESCALATION_MINUTES=15
PUBLIC_URL=http://localhost:5173
# Docker Compose (docker-compose.yml). There is no default database password: this must be set.
POSTGRES_PASSWORD=
SITE_ADDRESS=localhost
